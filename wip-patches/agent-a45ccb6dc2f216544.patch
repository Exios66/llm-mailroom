+# F2 - sorter window disagreement lowers confidence
+# ---------------------------------------------------------------------------
+
+
+def _read(cls, conf=0.99, **extra):
+    return {"doc_type": cls, "confidence": conf, "reasoning": f"r-{cls}", **extra}
