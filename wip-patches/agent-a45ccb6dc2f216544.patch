+
+    state = _conflict_state(
+        extracted_data={"parties": "not-a-list"}, extraction_confidence=0.1
+    )
+    assert after_extraction(state) == "retry_extract"
+    assert after_extraction({**state, "extraction_attempts": 3}) == "human_review"
