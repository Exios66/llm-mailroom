# === LLM Providers ===
# Primary: OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default provider — which LLM backend to use (openrouter | ollama | vllm | generic)
DEFAULT_PROVIDER=openrouter

# === Local Providers (later phase) ===
OLLAMA_BASE_URL=http://localhost:11434/v1
VLLM_BASE_URL=http://localhost:8000/v1

# Generic OpenAI-compatible fallback
GENERIC_API_KEY=
GENERIC_BASE_URL=

# === Database ===
DATABASE_URL=postgresql+asyncpg://mailroom:mailroom@localhost:5432/mailroom
DATABASE_URL_SYNC=postgresql+psycopg://mailroom:mailroom@localhost:5432/mailroom

# === Langfuse (self-hosted) ===
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local
LANGFUSE_HOST=http://localhost:3000

# === Pipeline ===
MAILROOM_BASE_DIR=./data
WATCHER_POLL_INTERVAL_SECONDS=2
OPS_MONITOR_INTERVAL_SECONDS=300
