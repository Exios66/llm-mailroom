# llm-mailroom — environment template
# Copy to .env and fill in real values (.env is gitignored).
# Full guide with per-provider/per-sink recipes: docs/configuration.md

# ── LLM provider ───────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_PROVIDER=openrouter        # openrouter | ollama | vllm | generic

# ── Local / offline providers ──────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
VLLM_BASE_URL=http://localhost:8000/v1
# Any other OpenAI-compatible endpoint:
GENERIC_API_KEY=
GENERIC_BASE_URL=

# Modal-deployed vLLM (KANBAN-064) — see deploy/README.md. Deploy once with:
#   cd deploy && modal deploy modal_vllm.py
# then flip DEFAULT_PROVIDER=vllm and point VLLM_BASE_URL at the printed
# *.modal.run URL; VLLM_API_KEY = the MODAL_VLLM_API_TOKEN you deployed with.
# Cross-repo: llm-entity-extraction speaks the SAME server through its own
# seam (OPENROUTER_BASE_URL), so ONE deployment can back BOTH pipelines.
# VLLM_BASE_URL=https://<workspace>--mailroom-vllm-serve.modal.run/v1
# VLLM_API_KEY=<your MODAL_VLLM_API_TOKEN value>
# Deploy-time knobs are set BEFORE `modal deploy`, not here:
#   MODAL_VLLM_MODEL / MODAL_VLLM_GPU / MODAL_VLLM_QUANTIZATION /
#   MODAL_VLLM_MAX_MODEL_LEN / MODAL_VLLM_API_TOKEN / HF_TOKEN

# ── Database ───────────────────────────────────────────────────────────────
# SQLite by default — no server needed. DB auto-created at
# {MAILROOM_BASE_DIR}/mailroom.db on first use.
# Postgres instead: docker compose -f config/docker/docker-compose.yml up -d postgres
# DATABASE_URL=postgresql+asyncpg://mailroom:mailroom@localhost:5432/mailroom

# ── Trace sinks ────────────────────────────────────────────────────────────
# Which backend receives pipeline traces: langfuse | braintrust | phoenix | none,
# or auto = first configured of langfuse -> braintrust -> phoenix (local-first
# fallback, tracing never silently turns off). `none` also gates graph startup.
OBSERVABILITY_PROVIDER=auto
# Environment label on traces; entrypoints set this automatically:
# live = watcher/API/ops monitor, pilot = run_pilot, misc = scripts, mock = fake-LLM runs
OBSERVABILITY_ENVIRONMENT=live

# Langfuse (self-hosted by default; for cloud use https://us.cloud.langfuse.com);
# LANGFUSE_BASE_URL accepted as alias.
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx
LANGFUSE_HOST=http://localhost:3000
# Optional SDK batching (defaults: 512 events / 5s). Short-lived jobs still
# MUST flush() before exit — the background exporter may not drain otherwise.
# Do not set LANGFUSE_FLUSH_AT=1 globally (API stampede). The pipeline also
# flushes after each graph node so The-Mailroom's live floor can move
# envelopes without waiting for this interval; 1s is still recommended when
# the visualizer is pointed at a live producer.
# LANGFUSE_FLUSH_AT=512
# LANGFUSE_FLUSH_INTERVAL=1
# LANGFUSE_RELEASE=mailroom@0.5.0
# LANGFUSE_TIMEOUT=5
# LANGFUSE_SAMPLE_RATE=1.0
# MAILROOM_TRACE_USER_ID=   # optional user_id on every document-pipeline trace

# Braintrust (set OBSERVABILITY_PROVIDER=braintrust)
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=mailroom

# Arize Phoenix — local, cost-free default fallback. Start with
#   phoenix serve   (then open http://localhost:6006); disable via PHOENIX_TRACING=disabled.
PHOENIX_TRACING=enabled
# PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
# PHOENIX_SERVICE_NAME=mailroom
# PHOENIX_PROJECT=mailroom

# Structured logging (pipeline/logging.py)
LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=pretty         # pretty (console) | json (machine-readable)
# LOG_FILE=./data/mailroom.log   # optional rotating file sink
# LOG_MAX_BYTES=10485760         # per-file rotation size (default 10 MB)
# LOG_BACKUP_COUNT=5             # rotated files kept

# ── Pipeline ───────────────────────────────────────────────────────────────
MAILROOM_BASE_DIR=./data
WATCHER_POLL_INTERVAL_SECONDS=1
# API embeds the inbox watcher so uploads drain without a second process.
# Set 0 when running a dedicated `python -m pipeline.watcher` (watcher.lock).
# MAILROOM_EMBED_WATCHER=1
# WATCHER_STALE_SECONDS=15          # /health checks.watcher lamp (live/stale/missing)
OPS_MONITOR_INTERVAL_SECONDS=300
# MAILROOM_VISION_ENABLED=0            # HF production pilots run text-only
# MAILROOM_PILOT_COST_ABORT=2.00       # cumulative USD abort for run_hf_pilot.py
# MAILROOM_DOCCLASS_PROMPTS=1          # KANBAN-090 docclass variants (or --docclass)

# ── API security (audit L-2/L-18) ─────────────────────────────────────────
# Bearer token REQUIRED on every endpoint except /health whenever the API
# binds anything but loopback; leave MAILROOM_API_TOKEN empty for local dev.
# MAILROOM_API_TOKEN=change-me
# MAILROOM_API_TOKENS=current-key,next-key   # additional live tokens (csv)
# MAILROOM_API_TOKEN_REVOKED=old-key         # subtracted from the live set
# MAILROOM_API_HOST=127.0.0.1     # 0.0.0.0 requires a token
# MAILROOM_API_PORT=8000
# The-Mailroom Observatory (sister visualizer, PR #30) must reach THIS API.
# Those three knobs live on the visualizer (or its Space secrets), not here:
#   MAILROOM_PIPELINE_URL=http://127.0.0.1:8000
#   # Space Observatory cannot use loopback — use the public producer Space:
#   # MAILROOM_PIPELINE_URL=https://<user>-mailroom-producer.hf.space
#   MAILROOM_PIPELINE_TOKEN=$MAILROOM_API_TOKEN
#   MAILROOM_PIPELINE_API_PREFIX=/v1
# Inbox "Queue a document" → POST /v1/upload (202). REVIEW → /v1/review/.../resolve.
# Local producer:
#   docker compose -f deploy/docker-compose.producer.yml --env-file .env up -d --build
# Hosted pair (producer Space + Observatory floor Space):
#   PYTHONPATH=src python src/scripts/publish_space.py --check
#   see deploy/space/PAIRING.md
# MAILROOM_MAX_UPLOAD_BYTES=52428800   # /upload cap (50 MB)
# MAILROOM_UPLOAD_RATE=20              # uploads per 60 s window

# ── LegalBench evaluation suite (legalbench/) ─────────────────────────────
# LEGALBENCH_EXPERIMENT_LOG=      # JSONL path (default: sibling repo's reports/experiment_log.jsonl)
# LEGALBENCH_SIBLING_REPO=        # llm-entity-extraction checkout (default: ../llm-entity-extraction)
