# === LLM Providers ===
# Primary: OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default provider — which LLM backend to use (openrouter | ollama | vllm | generic)
DEFAULT_PROVIDER=openrouter

# === Local / Offline Providers ===
OLLAMA_BASE_URL=http://localhost:11434/v1
VLLM_BASE_URL=http://localhost:8000/v1

# Modal-deployed vLLM (KANBAN-064) — see deploy/README.md. Deploy once with:
#   cd deploy && modal deploy modal_vllm.py
# then point these at the printed *.modal.run URL and set the SAME token you
# deployed with (MODAL_VLLM_API_TOKEN). OpenRouter stays primary unless you
# flip DEFAULT_PROVIDER=vllm above.
# VLLM_BASE_URL=https://<workspace>--mailroom-vllm-serve.modal.run/v1
# VLLM_API_KEY=<your MODAL_VLLM_API_TOKEN value>
# Deploy-time knobs (set BEFORE `modal deploy`, not in this file):
#   MODAL_VLLM_MODEL / MODAL_VLLM_GPU / MODAL_VLLM_QUANTIZATION /
#   MODAL_VLLM_MAX_MODEL_LEN / MODAL_VLLM_API_TOKEN / HF_TOKEN

# Generic OpenAI-compatible fallback
GENERIC_API_KEY=
GENERIC_BASE_URL=

# === Database ===
# SQLite by default — no server needed. The DB file is created at
# {MAILROOM_BASE_DIR}/mailroom.db (tables are auto-created on first use).
# To use Postgres instead, uncomment and set the line below (requires
# `docker compose -f config/docker/docker-compose.yml up -d postgres`).
# DATABASE_URL=postgresql+asyncpg://mailroom:mailroom@localhost:5432/mailroom

# === Observability (tracing) ===
# Which backend to log LLM calls to: auto | langfuse | braintrust | phoenix | none
#   auto       = langfuse if LANGFUSE_SECRET_KEY set, else braintrust if
#                BRAINTRUST_API_KEY set, else phoenix (local, cost-free) if
#                enabled, else disabled  <-- LOCAL-FIRST FALLBACK (aligned with
#                llm-entity-extraction): tracing never silently turns off.
#   langfuse   = Langfuse (cloud at LANGFUSE_HOST or LANGFUSE_BASE_URL, or self-hosted)
#   braintrust = Braintrust (needs BRAINTRUST_API_KEY)
#   phoenix    = Arize Phoenix (local OpenTelemetry, SQLite, no subscription/tokens)
#   none       = tracing off
OBSERVABILITY_PROVIDER=auto
# Langfuse environment for traces (entrypoints set this automatically):
# live = watcher/API/ops monitor, pilot = run_pilot, misc = scripts, mock = fake-LLM runs
OBSERVABILITY_ENVIRONMENT=live

# Structured logging (pipeline/logging.py)
# LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
# LOG_FORMAT=pretty         # pretty (console) | json (machine-readable)
# LOG_FILE=                 # optional rotating file sink (e.g. ./data/mailroom.log)
# LOG_MAX_BYTES=10485760    # rotation size per file (default 10 MB)
# LOG_BACKUP_COUNT=5        # rotated files kept (default 5)

# Langfuse (cloud or self-hosted). For cloud use:
#   LANGFUSE_HOST=https://us.cloud.langfuse.com
# LANGFUSE_BASE_URL is accepted as an alias for LANGFUSE_HOST.
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx
LANGFUSE_HOST=http://localhost:3000

# Braintrust (alternative backend — set OBSERVABILITY_PROVIDER=braintrust)
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=mailroom

# Arize Phoenix — local, cost-free tracing backend (default fallback).
# Single-process, SQLite-backed, OpenTelemetry-native; no cloud subscription,
# no quota, no cost on top of the LLM API calls. Start it with:
#   python -m phoenix.server.main serve   (or `phoenix serve`)
# then watch http://localhost:6006. Set PHOENIX_TRACING=disabled to turn off.
# PHOENIX_TRACING=enabled            # enabled (default) | disabled
# PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
# PHOENIX_SERVICE_NAME=mailroom
# PHOENIX_PROJECT=mailroom

# === Pipeline ===
MAILROOM_BASE_DIR=./data
WATCHER_POLL_INTERVAL_SECONDS=2
OPS_MONITOR_INTERVAL_SECONDS=300

# === API security (audit L-2/L-18) ===
# Bearer token required on every endpoint except /health. MANDATORY when the
# API binds anything but loopback. Leave empty for loopback-only dev.
# MAILROOM_API_TOKEN=change-me
# MAILROOM_API_HOST=127.0.0.1     # loopback by default; 0.0.0.0 requires a token
# MAILROOM_API_PORT=8000
# MAILROOM_MAX_UPLOAD_BYTES=52428800   # /upload size cap (50 MB default)
# MAILROOM_UPLOAD_RATE=20              # uploads per 60 s window

# === LegalBench evaluation suite (legalbench/) ===
# LEGALBENCH_EXPERIMENT_LOG=           # JSONL log path (default: sibling repo's
#                                     #  reports/experiment_log.jsonl, else legalbench/reports/)
# LEGALBENCH_SIBLING_REPO=             # llm-entity-extraction checkout used to rebuild the
#                                     #  experiment-log markdown + site (default: ../llm-entity-extraction)
